# 独立权限实验的授权模型 DSL，不是员工数据文件，也不是 SQL。
# 直接主管/HRBP/角色能力作为 tuples 同步；下方关系表达式由 OpenFGA 解释执行。
model
  schema 1.1

type user

type company
  # 公司对象保存“查看人是否有效、是否具备某种能力”，不是业务员工所属部门树。
  relations
    define active: [user]
    define reports_enabled: [user]
    define hrbp_enabled: [user]
    define inherit_hrbp_enabled: [user]
    define private_enabled: [user]
    define export_enabled: [user]

type employee
  relations
    # employee 是被查询的资源；owner 把资源关联到其本人 user，manager/hrbp 指向其他 employee。
    define owner: [user]
    define company: [company]
    define manager: [employee]
    define hrbp: [employee]

    # 只有管理关系参与递归，HRBP 服务边不参与管理链递归。
    define direct_manager: owner from manager
    define management_chain: direct_manager or management_chain from manager
    define direct_hrbp: owner from hrbp
    define inherited_hrbp: management_chain from hrbp

    # from company 将公司的用户能力集合带到每一条员工资源上，与具体关系授权求交。
    define active_user: active from company
    define reports_capability: reports_enabled from company
    define hrbp_capability: hrbp_enabled from company
    define inherit_capability: inherit_hrbp_enabled from company
    define private_capability: private_enabled from company
    define export_capability: export_enabled from company

    define report_grant: management_chain and reports_capability
    define hrbp_grant: direct_hrbp and hrbp_capability
    define inherited_hrbp_grant: inherited_hrbp and inherit_capability
    define candidate: owner or report_grant or hrbp_grant or inherited_hrbp_grant
    # 最终访问还要求有效用户；私人字段和导出是在基本可见性的基础上继续收窄。
    define view_basic: candidate and active_user
    define view_private: view_basic and private_capability
    define can_export: view_basic and export_capability
