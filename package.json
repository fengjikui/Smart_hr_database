{
  "name": "chengguan-hr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start --hostname 127.0.0.1",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "api": "uv run uvicorn backend.hr.api:app --host 127.0.0.1 --port 8000",
    "seed": "uv run python integrations/superset/export.py",
    "demo": "node scripts/dev.mjs",
    "demo:offline": "HR_QUERY_BACKEND=sqlite node scripts/dev.mjs",
    "demo:production": "node scripts/dev.mjs --production",
    "superset:up": "bash integrations/superset/services.sh up",
    "superset:setup": "uv run python integrations/superset/run.py setup",
    "superset:status": "uv run python integrations/superset/run.py status",
    "migrate": "uv run python scripts/migrate_local_state.py",
    "docs:check": "uv run python scripts/document_catalog.py --check",
    "check": "bash scripts/check.sh",
    "test": "uv run pytest -q",
    "test:model": "uv run python scripts/evaluate_model.py",
    "test:paraphrases": "uv run python scripts/evaluate_model.py --variants --output reports/paraphrases.json",
    "test:performance": "HR_QUERY_BACKEND=sqlite uv run python scripts/benchmark.py",
    "test:superset": "uv run python scripts/validate_superset.py",
    "test:revocation": "uv run python scripts/validate_revocation.py",
    "release": "bash scripts/release.sh",
    "openfga:up": "bash integrations/openfga/services.sh up",
    "openfga:init": "uv run python -m integrations.openfga.run init",
    "openfga:seed": "uv run python -m integrations.openfga.run seed",
    "openfga:sync": "uv run python -m integrations.openfga.run sync",
    "demo:openfga": "HR_QUERY_BACKEND=openfga HR_DATA_DIR=integrations/openfga/.local/app node scripts/dev.mjs",
    "test:openfga": "uv run python -m integrations.openfga.verify"
  },
  "dependencies": {
    "ag-grid-community": "36.1.0",
    "ag-grid-react": "36.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@openfga/syntax-transformer": "0.2.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.131.1"
  },
  "type": "module"
}
