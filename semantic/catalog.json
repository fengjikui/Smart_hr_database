    {
      "id": "leave_days",
      "name": "已批准请假天数",
      "domain": "考勤",
      "unit": "天",
      "description": "选定期间已批准整日请假天数。演示不包含半天、跨时区与跨午夜班次。",
      "aliases": [
        "请假",
        "休假",
