{
  "version": "hr-metrics-1.0",
  "owner": "演示数据治理组",
  "timezone": "Asia/Shanghai",
  "metrics": [
    {
      "id": "headcount",
      "name": "在职人数",
      "domain": "人员",
      "unit": "人",
      "description": "在统计日已入职且尚未离职的去重员工数，包含正式、实习和外包。离职日不计在职。",
      "aliases": [
        "人数",
        "员工数",
        "人员规模",
        "下属"
      ],
      "dimensions": [
        "division",
        "department",
        "job_family",
        "location",
        "employment_type",
        "relation",
        "month"
      ],
      "source": [
        "employees",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月在职人数"
    },
    {
      "id": "hires",
      "name": "新入职人数",
      "domain": "人员",
      "unit": "人",
      "description": "入职日期落在选定期间的去重员工数，组织按入职时任职关系归属。",
      "aliases": [
        "新增",
        "入职",
        "招聘入职"
      ],
      "dimensions": [
        "division",
        "department",
        "location",
        "month"
      ],
      "source": [
        "employees",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月新入职人数"
    },
    {
      "id": "departures",
      "name": "离职人数",
      "domain": "人员",
      "unit": "人",
      "description": "离职日期落在选定期间的去重员工数，组织按离职日前一天归属。",
      "aliases": [
        "离职",
        "流失人数"
      ],
      "dimensions": [
        "division",
        "department",
        "month"
      ],
      "source": [
        "employees",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月离职人数"
    },
    {
      "id": "turnover_rate",
      "name": "人员离职率",
      "domain": "人员",
      "unit": "%",
      "description": "期间离职人数 ÷ ((期初在职人数 + 期末在职人数) / 2) × 100。为演示统一口径，不进行年化。",
      "aliases": [
        "离职率",
        "流失率"
      ],
      "dimensions": [
        "division",
        "department"
      ],
      "source": [
        "employees",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月人员离职率"
    },
    {
      "id": "avg_tenure",
      "name": "平均司龄",
      "domain": "人员",
      "unit": "年",
      "description": "统计日在职员工从最近入职日起至统计日的天数 / 365.25 的算术平均。",
      "aliases": [
        "司龄",
        "工龄"
      ],
      "dimensions": [
        "division",
        "department",
        "job_family"
      ],
      "source": [
        "employees",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月平均司龄"
    },
    {
      "id": "attendance_rate",
      "name": "出勤率",
      "domain": "考勤",
      "unit": "%",
      "description": "正常或远程出勤人日 ÷ (应出勤人日 - 已批准整日请假人日) × 100。缺卡、缺勤不计完成出勤。",
      "aliases": [
        "出勤",
        "到岗率"
      ],
      "dimensions": [
        "division",
        "department",
        "day",
        "month"
      ],
      "source": [
        "attendance_daily",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月出勤率"
    },
    {
      "id": "late_count",
      "name": "迟到人次",
      "domain": "考勤",
      "unit": "人次",
      "description": "工作日上班打卡晚于 09:30 的人日数。09:30 整不迟到。",
      "aliases": [
        "迟到",
        "迟到次数"
      ],
      "dimensions": [
        "division",
        "department",
        "day",
        "month"
      ],
      "source": [
        "attendance_daily",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月迟到人次"
    },
    {
      "id": "late_rate",
      "name": "迟到率",
      "domain": "考勤",
      "unit": "%",
      "description": "迟到人次 ÷ 有上班打卡的应出勤人次 × 100。远程同样按弹性规则统计。",
      "aliases": [
        "迟到率"
      ],
      "dimensions": [
        "division",
        "department",
        "day",
        "month"
      ],
      "source": [
        "attendance_daily",
        "assignments"
      ],
      "owner": "HR 数据负责人（模拟）",
      "version": "1.0",
      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月迟到率"
    },
    {
      "id": "abnormal_count",
      "name": "考勤异常人次",
      "domain": "考勤",
      "unit": "人次",
      "description": "迟到、早退、缺勤或缺卡任一条件成立的人日数，同一人同一天只计一次。",
      "aliases": [
        "异常",
