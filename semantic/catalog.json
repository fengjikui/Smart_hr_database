      "sensitivity": "internal",
      "minimum_group_size": 1,
      "example": "按事业部统计本月考勤异常人次"
    },
    {
      "id": "approved_overtime_hours",
      "name": "已批准加班时长",
      "domain": "考勤",
      "unit": "小时",
      "description": "选定期间已批准加班申请的分钟数之和 / 60。晚离岗不会自动认定为加班。",
      "aliases": [
        "加班",
        "审批加班",
