    {
      "id": "late_departure_hours",
      "name": "晚离岗时长",
      "domain": "考勤",
      "unit": "小时",
      "description": "下班晚于个人应离岗时间的分钟数之和 / 60。应离岗时间为 max(18:00, 上班时间 + 9小时)，午休为1小时。该指标不是劳动报酬口径。",
      "aliases": [
        "晚下班",
        "晚离岗",
        "晚走"
      ],
      "dimensions": [
        "division",
